{
  "name": "gitlab-reminders",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.ts",
    "build:release": "node scripts/build.ts --release",
    "watch": "node scripts/build.ts --watch",
    "typecheck": "tsc --noEmit",
    "test": "esbuild test/engine.test.ts --bundle --platform=node --format=esm --outfile=.test/engine.test.mjs --log-level=warning && node --test .test/engine.test.mjs"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.8",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
